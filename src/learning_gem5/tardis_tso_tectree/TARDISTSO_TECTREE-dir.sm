else if (AuthTBEs.lookup_ref(missing_parent).Waiter123 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter123 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter124 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter124 := data_addr; }
