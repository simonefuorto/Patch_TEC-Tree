else if (AuthTBEs.lookup_ref(missing_parent).Waiter83 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter83 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter84 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter84 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter85 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter85 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter86 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter86 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter87 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter87 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter88 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter88 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter89 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter89 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter90 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter90 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter91 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter91 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter92 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter92 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter93 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter93 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter94 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter94 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter95 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter95 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter96 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter96 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter97 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter97 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter98 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter98 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter99 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter99 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter100 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter100 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter101 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter101 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter102 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter102 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter103 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter103 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter104 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter104 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter105 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter105 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter106 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter106 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter107 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter107 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter108 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter108 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter109 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter109 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter110 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter110 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter111 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter111 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter112 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter112 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter113 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter113 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter114 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter114 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter115 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter115 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter116 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter116 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter117 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter117 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter118 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter118 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter119 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter119 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter120 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter120 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter121 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter121 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter122 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter122 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter123 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter123 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter124 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter124 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter125 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter125 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter126 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter126 := data_addr; }
else if (AuthTBEs.lookup_ref(missing_parent).Waiter127 == intToAddress(0)) { AuthTBEs.lookup_ref(missing_parent).Waiter127 := data_addr; }
                } else {
                    Addr L1 := getParentAddrDynamic(data_addr, tectree_arity);
                    if (L1 != intToAddress(0) && LLC.isTagPresent(L1)) {
                        getLLCEntry(L1).Dirty := true;
                        getDirectoryEntry(L1).DirState := State:C_M;
                        if (mru_policy == 0) {
	LLC.setMRU(L1);
	} else if (mru_policy == 2 && rand() % 10 < 3) { LLC.setMRU(L1); }
                        Addr L2 := getParentAddrDynamic(L1, tectree_arity);
                        if (L2 != intToAddress(0) && LLC.isTagPresent(L2)) {
                            getLLCEntry(L2).Dirty := true;
                            getDirectoryEntry(L2).DirState := State:C_M;
                            if (mru_policy == 0) {
	LLC.setMRU(L2);
	} else if (mru_policy == 2 && rand() % 10 < 4) { LLC.setMRU(L2); }
                            Addr L3 := getParentAddrDynamic(L2, tectree_arity);
                            if (L3 != intToAddress(0) && LLC.isTagPresent(L3)) {
                                getLLCEntry(L3).Dirty := true;
                                getDirectoryEntry(L3).DirState := State:C_M;
                                if (mru_policy == 0) {
	LLC.setMRU(L3);
	} else if (mru_policy == 2 && rand() % 10 < 5) { LLC.setMRU(L3); }
                                Addr L4 := getParentAddrDynamic(L3, tectree_arity);
                                if (L4 != intToAddress(0) && LLC.isTagPresent(L4)) {
                                    getLLCEntry(L4).Dirty := true;
                                    getDirectoryEntry(L4).DirState := State:C_M;
                                    if (mru_policy == 0) {
	LLC.setMRU(L4);
	} else if (mru_policy == 2 && rand() % 10 < 6) { LLC.setMRU(L4); }
                                    Addr L5 := getParentAddrDynamic(L4, tectree_arity);
                                    if (L5 != intToAddress(0) && LLC.isTagPresent(L5)) {
                                        getLLCEntry(L5).Dirty := true;
                                        getDirectoryEntry(L5).DirState := State:C_M;
                                        if (mru_policy == 0) {
	LLC.setMRU(L5);
	} else if (mru_policy == 2 && rand() % 10 < 8) { LLC.setMRU(L5); }
                                        Addr L6 := getParentAddrDynamic(L5, tectree_arity);
                                        if (L6 != intToAddress(0) && LLC.isTagPresent(L6)) {
                                            getLLCEntry(L6).Dirty := true;
                                            getDirectoryEntry(L6).DirState := State:C_M;
                                            if (mru_policy == 0) {
	LLC.setMRU(L6);
	} else if (mru_policy == 2) { LLC.setMRU(L6); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    
                    Entry data_dir_entry := getDirectoryEntry(data_addr);
                    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
                        out_msg.addr := data_addr;
                        out_msg.Type := MemoryRequestType:MEMORY_WB;
                        out_msg.Sender := machineID;
                        out_msg.MessageSize := MessageSizeType:Writeback_Data;
                        out_msg.DataBlk := TBEs[data_addr].DataBlk;
                    }
                    if (data_dir_entry.DirState == State:I_Evict_Auth) {
                        getDirectoryEntry(data_addr).DirState := State:I_Evicting;
                        TBEs[data_addr].TBEState := State:I_Evicting;
                    } else if (data_dir_entry.DirState == State:S_Evict_Auth) {
                        getDirectoryEntry(data_addr).DirState := State:S_Evicting;
                        TBEs[data_addr].TBEState := State:S_Evicting;
                    } else if (data_dir_entry.DirState == State:E_Evict_Auth) {
                        getDirectoryEntry(data_addr).DirState := State:E_Evicting;
                        TBEs[data_addr].TBEState := State:E_Evicting;
                    }
                    DPRINTF(Tectree, "[Cascading Eviction] Il blocco 0x%x ha tutto il ramo pronto! Sfrattato in MEMORY_WB.\n", data_addr);
                }
            }
        }
    }

	action(deallocateCounterAuthTBE, "dCA", desc="Deallocate AuthTBE for the counter") {
		if (AuthTBEs.isPresent(address)) {
			AuthTBEs.deallocate(address);
		}
	}

	action(recycleRequestQueue, "rR", desc="Recycle request queue") {
		request_in.recycle(clockEdge(), cyclesToTicks(to_memory_controller_latency));
	}

	//-------------------------------------------------------------------------------
	//Funzione per implementare la ricorsione
	action(checkRecursionAndWakeUp, "cRW", desc="Check if parent counter is missing") {
        peek(memQueue_in, MemoryMsg) {
            Addr parent_addr := getParentAddrDynamic(address, tectree_arity);
            
            // 1. ATTIVIAMO LA RICORSIONE: il padre manca se l'indirizzo non è 0 (Root) e non è in LLC
            bool parent_missing := (parent_addr != intToAddress(0)) && (LLC.isTagPresent(parent_addr) == false);

            if (parent_missing) {
                // 2. PROTEZIONE MSHR: Allochiamo l'AuthTBE per il PADRE (se non esiste già) per evitare fetch doppi!
                if (AuthTBEs.isPresent(parent_addr) == false) {
                    AuthTBEs.allocate(parent_addr);
                    
                    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
                        out_msg.addr := parent_addr;
                        out_msg.Type := MemoryRequestType:MEMORY_READ;
                        out_msg.Sender := machineID;
                        out_msg.MessageSize := MessageSizeType:Request_Control;
                        out_msg.Len := 0;
                    }
                    DPRINTF(Tectree, "[RECURSION] Counter 0x%x arrivato, ma padre 0x%x assente! Fetch del padre avviato.\n", address, parent_addr);
                } else {
                    DPRINTF(Tectree, "[RECURSION] Counter 0x%x arrivato, padre 0x%x assente ma FETCH GIA' IN CORSO da un altro blocco.\n", address, parent_addr);
                }
                
                
                
            } else {
                // 3. FINE RICORSIONE: Abbiamo raggiunto la Root (0) oppure il padre era già caldissimo in LLC!
                wakeUpAllBuffers();
                DPRINTF(Tectree, "[WAKE-UP] Counter 0x%x arrivato. Percorso completato! Risveglio il Dato originale\n", address);
            }
        }
	}
	
	action(incrementCounter,"inc", desc="Incrementa l\'intero ramo dei Counter presenti in LLC"){
        updateTreeInCache(address);
    }
	
	//--------------------------------------------------------------------------------
    
	
	

	// Queue management


        action(wakeUpAll_Dup, "wuADup", desc="Wake up all stalled buffers for duplicate counter") {
        wakeUpAllBuffers();
        DPRINTF(Tectree, "[WAKE-UP] Duplicate Counter 0x%x arrived. Risveglio i buffer in stallo.\\n", address);
    }

	action(wakeUpAll, "wuA", desc="Wake up all stalled buffers blindly") {
		wakeUpAllBuffers();
	}    

    action(wakeUp, "wu", desc="Wake up stalled buffers") {
        wakeUpBuffers(address);
    }

    action(popResponseQueue, "pR", desc="Pop the response queue") {
        response_in.dequeue(clockEdge());
    }

    action(popRequestQueue, "pQ", desc="Pop the request queue") {
        request_in.dequeue(clockEdge());
    }

    action(popMemQueue, "pM", desc="Pop the memory queue") {
        dequeueMemRespQueue();
    }

    action(stall, "z", desc="Stall the incoming request") {
        // Built-in SLICC z_stall
    }

    action(z_stallAndWaitRequest, "zSW", desc="Stall and wait the request in a side buffer") {
        stall_and_wait(request_in, address);
    }


    /*************************************************************************/
	///TARDIS TSO Transitions
	
	transition(I, ShReq, IS){
		allocateTBE_ReqIn;
		storeLtsTBE_ReqIn;
		storeTimestampsTBE_ReqIn;
		sendMemoryRequest;
		popRequestQueue;
	}

	transition(I, ShReq_Hit, S) {
		setLLCTimestamps;
		sendShDataFromLLC;
		setMRU;
		popRequestQueue;
	}
	
	transition(I, ExReq, IE){
		allocateTBE_ReqIn;
		sendMemoryRequest;
		popRequestQueue;
	}

	transition(I, ExReq_Hit, E) {
		setLLCTimestamps;
		sendExDataFromLLC;
		setOwner_ReqIn;
		setMRU;
		popRequestQueue;
	}
	
						// --- Transizioni per il Fetch del Counter ---
	transition(I, Auth_Miss, I_Fetch_Auth) {
		fetchCounterIfNeeded;
		z_stallAndWaitRequest;
	}
	transition(S, Auth_Miss, S_Fetch_Auth) {
		fetchCounterIfNeeded;
		z_stallAndWaitRequest;
	}
	transition(E, Auth_Miss, E_Fetch_Auth) {
		fetchCounterIfNeeded;
		z_stallAndWaitRequest;
	}

	transition({I_Fetch_Auth, S_Fetch_Auth, E_Fetch_Auth}, Auth_Miss) {
		z_stallAndWaitRequest;
	}

	// STATE BOUNCING: Quando i Dati in stallo vengono svegliati da wakeUpAllBuffers,
	// rimbalzano temporaneamente allo stato base per riprocessare la richiesta.
	transition(I_Fetch_Auth, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, FlushRep, UpgReq}, I) {
		recycleRequestQueue;
	}
	transition(S_Fetch_Auth, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, FlushRep, UpgReq}, S) {
		recycleRequestQueue;
	}
	transition(E_Fetch_Auth, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, FlushRep, UpgReq}, E) {
		recycleRequestQueue;
	}

	// Al ritorno del Counter_Data sulla DIRECTORY entry del COUNTER! (Stato sempre I)
	transition(I, Counter_Data) {
		allocateCounterLLC;
        resumeEvictions;
		checkRecursionAndWakeUp;
		deallocateCounterAuthTBE;
		popMemQueue;
	}

	// Gestione dei Counter Data orfani o duplicati (causa coalescing della memoria)
	transition(I, Memory_Data, I) {
		allocateCounterLLC;
		wakeUpAll;
		popMemQueue;
	}
	// ------------------------------------------

	
	transition(IS, Memory_Data, S){
		setMemoryTimestamps;
		allocateOrUpdateLLCFromMem;
		setMRU;
		sendShDataToReq;
		deallocateTBE;
        popMemQueue;
	}

	transition(IE, Memory_Data, E){
		setMemoryTimestamps;
		allocateOrUpdateLLCFromMem;
		setMRU;
		sendExDataToReq;
		setOwner;
		deallocateTBE;
        popMemQueue;
	}
	
	transition(S, ShReq, IS){
		allocateTBE_ReqIn;
		storeLtsTBE_ReqIn;
		storeTimestampsTBE_ReqIn;
		sendMemoryRequest;
		popRequestQueue;
	}

	transition(S, ShReq_Hit, S) {
		setLLCTimestamps;
		sendShDataFromLLC;
		setMRU;
		popRequestQueue;
	}

	transition(S, ExReq, SE){
		allocateTBE_ReqIn;
		sendMemoryRequest;
		popRequestQueue;	
	}

	transition(S, ExReq_Hit, E) {
		setLLCTimestamps;
		sendExDataFromLLC;
		setOwner_ReqIn;
		setMRU;
		popRequestQueue;
	}

	transition(S, UpgReq, E){
		setOwner_ReqIn;
		sendUpgradeRep;
		popRequestQueue;
	}

	transition(SE, Memory_Data, E){
		setMemoryTimestamps;
		sendExDataToReq;
		setOwner;
		deallocateTBE;
        popMemQueue;
	}
	
	transition(E, FlushRep, S){
		allocateTBE_RepIn;
		storeTimestamps_RepIn;
		allocateOrUpdateLLC;
		setMRU;
		sendAckRepTBE;
		clearOwner;
		deallocateTBE;
		popResponseQueue;
	}

	transition(E, {ShReq, ShReq_Hit}, ES){
		allocateTBE_ReqIn;
		sendWritebackRequest;
		clearOwner;
		popRequestQueue;
	}

	transition(ES, FlushRep, S){
		storeDataBlockTBE;
		storeLtsTBE_RepIn;
		storeTimestampsTBE_RepIn;
		storeTimestamps_RepIn;
		allocateOrUpdateLLC;
		setMRU;
		sendShTBEDataToReq;
		deallocateTBE;
		popResponseQueue;
	}
	
	transition(E, {ExReq, ExReq_Hit, UpgReq}, EE){
		allocateTBE_ReqIn;
		sendFlushReq;
		clearOwner;
        popRequestQueue;
	}

	transition(EE, FlushRep, E){
		storeDataBlockTBE;
		storeLtsTBE_RepIn;
		storeTimestampsTBE_RepIn;
		storeTimestamps_RepIn;
		allocateOrUpdateLLC;
		setMRU;
		sendExTBEDataToReq;
		setOwner;
		deallocateTBE;
		popResponseQueue;
	}

	transition({IS, IE}, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, UpgReq, Auth_Miss}) {
		stall;	//TODO: For IS case, to acquire better performance, it should not block simultaneous Shared Requests.
	}

	transition({ES, SE, EE}, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, UpgReq, Auth_Miss}) {
		stall;
	}

    transition({I_Evicting, S_Evicting, E_Evicting}, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, UpgReq, Auth_Miss}) {
        stall;
    }

    transition({I_Evicting, S_Evicting, E_Evicting}, {FlushRep}) {
        stall;
    }

    // --- LLC Eviction Transitions ---

    // Step 4.4: Sfratto sporco ma Counter assente (Non-Blocking!)
    // 1. Alloco TBE per parcheggiare il dato
    // 2. Chiedo il Counter e mi metto in slot (fetchCounterForEviction)
    // 3. DEALLOCO SUBITO la cache per sbloccare la coda e non causare deadlock!
    transition(I, LLC_Repl_Dirty_Auth_Miss, I_Evict_Auth) { 
		incrementRootCounter;
		allocateTBE_Eviction; 
		fetchCounterForEviction; 
		deallocateLLC; 
		}
    transition(S, LLC_Repl_Dirty_Auth_Miss, S_Evict_Auth) { 
		incrementRootCounter;
		allocateTBE_Eviction; 
		fetchCounterForEviction; 
		deallocateLLC; 
		}
    transition(E, {LLC_Repl_Dirty, LLC_Repl_Dirty_Auth_Miss}, E_Evict_Flush) { 
        allocateTBE_Eviction; 
        sendFlushReq; 
        deallocateLLC;
    }
    
    // Le transizioni per LLC_Repl_Dirty su *_Evict_Auth sono rimosse, se ne occupa resumeEvictions

    transition({I_Evict_Auth, S_Evict_Auth, E_Evict_Auth, E_Evict_Flush}, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, UpgReq, Auth_Miss}) { stall; }
    transition({I_Evict_Auth, S_Evict_Auth, E_Evict_Auth}, LLC_Repl_Clean) { stall; }

    // Clean eviction: Just drop the block silently
    transition(I, LLC_Repl_Clean, I) { deallocateLLC; }
    transition(S, LLC_Repl_Clean, S) { deallocateLLC; }
    transition(E, LLC_Repl_Clean, E) { deallocateLLC; }

    // Dirty eviction: Must write back to Memory
    transition(I, LLC_Repl_Dirty, I_Evicting) { 
		incrementCounter;
		incrementRootCounter;
		allocateTBE_Eviction; 
		sendBlockToMem_Eviction; 
		deallocateLLC; 
		}
    transition(S, LLC_Repl_Dirty, S_Evicting) {
		incrementCounter;
		incrementRootCounter;
		allocateTBE_Eviction; 
		sendBlockToMem_Eviction; 
		deallocateLLC; 
		}
    transition(E_Evict_Flush, LLC_Repl_Dirty_Auth_Hit_From_Flush, I_Evicting) {
        clearOwner;
        storeDataBlockTBE;
        incrementCounter;
        incrementRootCounter;
        sendBlockToMem_Eviction;
        deallocateLLC;
        popResponseQueue;
    }
    
    transition(E_Evict_Flush, LLC_Repl_Dirty_Auth_Miss_From_Flush, I_Evict_Auth) {
        clearOwner;
        storeDataBlockTBE;
        incrementRootCounter;
        fetchCounterForEviction;
        deallocateLLC;
        popResponseQueue;
    }

    // If the victim is currently in a transient state, stall the eviction
    transition({IS, IE, SE, EE, ES, I_Fetch_Auth, S_Fetch_Auth, E_Fetch_Auth, I_Evicting, S_Evicting, E_Evicting, E_Evict_Flush }, {LLC_Repl_Clean, LLC_Repl_Dirty}) {
        stall;
    }

    // Acknowledge from Memory that the writeback is complete
    transition(I_Evicting, Memory_Ack, I) { popMemQueue; deallocateTBE; wakeUp; }
    transition(S_Evicting, Memory_Ack, S) { popMemQueue; deallocateTBE; wakeUp; }
    transition(E_Evicting, Memory_Ack, E) { popMemQueue; deallocateTBE; wakeUp; }
  
    //Evizioni di CounterChunk
  	transition(C_V, LLC_Repl_Clean, I){
		recordPrefetchHit;
		deallocateLLC;
	}
	transition(C_M, LLC_Repl_Dirty, I_Evicting){
		recordPrefetchMiss;
		allocateTBE_Eviction;
		sendBlockToMem_Eviction;
		deallocateLLC;
	}

	transition(C_M, LLC_Repl_Dirty_Auth_Miss, I_Evict_Auth) {
		recordPrefetchMiss;
		allocateTBE_Eviction;
		fetchCounterForEviction;
		deallocateLLC;
	}

	//I CounteChunk non possono essere richiesti dai core (non sanno della loro esistenza)
	transition({C_V, C_M}, {ShReq, ShReq_Hit, ExReq, ExReq_Hit, UpgReq, FlushRep}) {
		z_stallAndWaitRequest;
	}

}