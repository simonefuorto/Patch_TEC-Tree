	AuthTBETable AuthTBEs, template="<Directory_AuthTBE>", constructor="m_number_of_TBEs";
	
	//--------------------------------------------------------------------------------------------




    



    Tick clockEdge();
	Cycles ticksToCycles(Tick t);
	Tick cyclesToTicks(Cycles c);
	void set_tbe(TBE b);
	void unset_tbe();
	void set_cache_entry(AbstractCacheEntry b);
	void unset_cache_entry();
    void wakeUpBuffers(Addr a);
    void wakeUpAllBuffers();

    // This either returns the valid directory entry, or, if it hasn't been
    // allocated yet, this allocates the entry. This may save some host memory
    // since this is lazily populated.
    Entry getDirectoryEntry(Addr addr), return_by_pointer="yes" {
		Entry dir_entry := static_cast(Entry, "pointer", directory[addr]);

		if (is_valid(dir_entry)) {
			return dir_entry;
		}

		dir_entry :=  static_cast(Entry, "pointer",
								directory.allocate(addr, new Entry));
		return dir_entry;
	}

    LLC_Entry getLLCEntry(Addr addr), return_by_pointer="yes" {
        LLC_Entry llc_entry := static_cast(LLC_Entry, "pointer", LLC.lookup(addr));
        return llc_entry;
    }

    int getL6Index(Addr addr) {
        return (addressToInt(addr) / 64) / 11390625;
    }
  void updateOneLevel(Addr parent_addr, int level) {
      if (parent_addr != intToAddress(0) && LLC.isTagPresent(parent_addr)) {
          getLLCEntry(parent_addr).Dirty := true;
          getDirectoryEntry(parent_addr).DirState := State:C_M;
          if (mru_policy == 0) { LLC.setMRU(parent_addr); }
          else if (mru_policy == 2 && rand() % 10 < (3 + level)) { LLC.setMRU(parent_addr); }
      }
  }

  void updateTreeInCache(Addr data_addr) {
      Addr P1 := getParentAddrDynamic(data_addr, tectree_arity);
      if (P1 != intToAddress(0) && LLC.isTagPresent(P1)) {
          updateOneLevel(P1, 0);
          Addr P2 := getParentAddrDynamic(P1, tectree_arity);
          if (P2 != intToAddress(0) && LLC.isTagPresent(P2)) {
              updateOneLevel(P2, 1);
              Addr P3 := getParentAddrDynamic(P2, tectree_arity);
              if (P3 != intToAddress(0) && LLC.isTagPresent(P3)) {
                  updateOneLevel(P3, 2);
                  Addr P4 := getParentAddrDynamic(P3, tectree_arity);
                  if (P4 != intToAddress(0) && LLC.isTagPresent(P4)) {
                      updateOneLevel(P4, 3);
                      Addr P5 := getParentAddrDynamic(P4, tectree_arity);
                      if (P5 != intToAddress(0) && LLC.isTagPresent(P5)) {
                          updateOneLevel(P5, 4);
                          Addr P6 := getParentAddrDynamic(P5, tectree_arity);
                          if (P6 != intToAddress(0) && LLC.isTagPresent(P6)) {
                              updateOneLevel(P6, 5);
                              Addr P7 := getParentAddrDynamic(P6, tectree_arity);
                              if (P7 != intToAddress(0) && LLC.isTagPresent(P7)) {
                                  updateOneLevel(P7, 6);
                                  Addr P8 := getParentAddrDynamic(P7, tectree_arity);
                                  if (P8 != intToAddress(0) && LLC.isTagPresent(P8)) {
                                      updateOneLevel(P8, 7);
                                      Addr P9 := getParentAddrDynamic(P8, tectree_arity);
                                      if (P9 != intToAddress(0) && LLC.isTagPresent(P9)) {
                                          updateOneLevel(P9, 8);
                                          Addr P10 := getParentAddrDynamic(P9, tectree_arity);
                                          if (P10 != intToAddress(0) && LLC.isTagPresent(P10)) {
                                              updateOneLevel(P10, 9);
                                          }
                                      }
                                  }
                              }
                          }
                      }
                  }
              }
          }
      }
  }

  Addr getFirstMissingParent(Addr data_addr) {
      Addr P1 := getParentAddrDynamic(data_addr, tectree_arity);
      if (P1 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P1) == false) { return P1; }
      
      Addr P2 := getParentAddrDynamic(P1, tectree_arity);
      if (P2 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P2) == false) { return P2; }
      
      Addr P3 := getParentAddrDynamic(P2, tectree_arity);
      if (P3 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P3) == false) { return P3; }
      
      Addr P4 := getParentAddrDynamic(P3, tectree_arity);
      if (P4 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P4) == false) { return P4; }
      
      Addr P5 := getParentAddrDynamic(P4, tectree_arity);
      if (P5 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P5) == false) { return P5; }
      
      Addr P6 := getParentAddrDynamic(P5, tectree_arity);
      if (P6 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P6) == false) { return P6; }
      
      Addr P7 := getParentAddrDynamic(P6, tectree_arity);
      if (P7 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P7) == false) { return P7; }
      
      Addr P8 := getParentAddrDynamic(P7, tectree_arity);
      if (P8 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P8) == false) { return P8; }

      Addr P9 := getParentAddrDynamic(P8, tectree_arity);
      if (P9 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P9) == false) { return P9; }

      Addr P10 := getParentAddrDynamic(P9, tectree_arity);
      if (P10 == intToAddress(0)) { return intToAddress(0); }
      if (LLC.isTagPresent(P10) == false) { return P10; }

      return intToAddress(0);
  }

  void setMRUTree(Addr data_addr) {
      Addr P1 := getParentAddrDynamic(data_addr, tectree_arity);
      if (P1 != intToAddress(0) && LLC.isTagPresent(P1)) {
          if (mru_policy == 0) { LLC.setMRU(P1); }
          Addr P2 := getParentAddrDynamic(P1, tectree_arity);
          if (P2 != intToAddress(0) && LLC.isTagPresent(P2)) {
              if (mru_policy == 0) { LLC.setMRU(P2); }
              Addr P3 := getParentAddrDynamic(P2, tectree_arity);
              if (P3 != intToAddress(0) && LLC.isTagPresent(P3)) {
                  if (mru_policy == 0) { LLC.setMRU(P3); }
                  Addr P4 := getParentAddrDynamic(P3, tectree_arity);
                  if (P4 != intToAddress(0) && LLC.isTagPresent(P4)) {
                      if (mru_policy == 0) { LLC.setMRU(P4); }
                      Addr P5 := getParentAddrDynamic(P4, tectree_arity);
                      if (P5 != intToAddress(0) && LLC.isTagPresent(P5)) {
                          if (mru_policy == 0) { LLC.setMRU(P5); }
                          Addr P6 := getParentAddrDynamic(P5, tectree_arity);
                          if (P6 != intToAddress(0) && LLC.isTagPresent(P6)) {
                              if (mru_policy == 0) { LLC.setMRU(P6); }
                          }
                      }
                  }
              }
          }
      }
  }



	State getState(TBE tbe, LLC_Entry cache_entry, Addr addr) {
		if (is_valid(tbe)) {
			return tbe.TBEState;
		} else if (directory.isPresent(addr)) {
			return getDirectoryEntry(addr).DirState;
		} else {
			return State:I;
		}
	}

	void setState(TBE tbe, LLC_Entry cache_entry, Addr addr, State state) {

		if (is_valid(tbe)) {
			tbe.TBEState := state;
		}

		if (directory.isPresent(addr)) {
			if (state == State:E) {
				DPRINTF(RubySlicc, "Owners %s. Count: %d. Address: 0x%x\n", getDirectoryEntry(addr).Owner, getDirectoryEntry(addr).Owner.count(), addr);
				assert(getDirectoryEntry(addr).Owner.count() == 1);
			}

			getDirectoryEntry(addr).DirState := state;

			if (state == State:I)  {
				assert(getDirectoryEntry(addr).Owner.count() == 0);
			}
		}
	}

	AccessPermission getAccessPermission(Addr addr) {
		TBE tbe := TBEs[addr];
		if(is_valid(tbe)) {
		return Directory_State_to_permission(tbe.TBEState);
		}

		if(directory.isPresent(addr)) {
		return Directory_State_to_permission(getDirectoryEntry(addr).DirState);
		}

		return AccessPermission:NotPresent;
	}

	void setAccessPermission(LLC_Entry cache_entry, Addr addr, State state) {
		if (directory.isPresent(addr)) {
		getDirectoryEntry(addr).changePermission(Directory_State_to_permission(state));
		}
	}

	void functionalRead(Addr addr, Packet *pkt) {
		// if this is called; state is always either invalid or data was just been WB
		// to memory (and we are waiting for an ack), so go directly to memory
		functionalMemoryRead(pkt);
	}

	int functionalWrite(Addr addr, Packet *pkt) {
		int num_functional_writes := 0;

		TBE tbe := TBEs[addr];
		if(is_valid(tbe)) {
		num_functional_writes := num_functional_writes +
				testAndWrite(addr, tbe.DataBlk, pkt);
		}

		num_functional_writes := num_functional_writes + functionalMemoryWrite(pkt);
		return num_functional_writes;
	}

	int max(int i1, int i2){
		if(i1 > i2){
			return i1;
		}else{
			return i2;
		}
	}
	
	int max(int i1, int i2, int i3){
		if (i1 >= i2 && i1 >= i3) {
        	return i1;
		} else if (i2 >= i1 && i2 >= i3) {
			return i2;
		} else {
			return i3;
		}
	}

    /*************************************************************************/	
    // Input/output network definitions
	
	//Output port of Timestamp Manager used to send FLUSH_REQ and WB_REQ to Caches
    out_port(forward_out, RequestMsg, forwardToCache);
	
	//Output port of Timestamp Manager used to send SH_REP, EX_REP, RENEW_REP and UPGR_REP to Caches
    out_port(response_out, ResponseMsg, responseToCache);
	
	//Output port of Timestamp Manager used to send MEM_REQ to Memory DRAM
    out_port(memQueue_out, MemoryMsg, requestToMemory);

    in_port(memQueue_in, MemoryMsg, responseFromMemory) {
        if (memQueue_in.isReady(clockEdge())) {
            peek(memQueue_in, MemoryMsg) {
				DPRINTF(RubySlicc, "Received in memQueue_in %s with address 0x%x\n", in_msg.Type, in_msg.addr);
				TBE tbe := TBEs[in_msg.addr];
				LLC_Entry cache_entry := getLLCEntry(in_msg.addr);
				
                if (in_msg.Type == MemoryRequestType:MEMORY_READ) {	//If the request is MEMORY READ
                    if (is_invalid(cache_entry) && LLC.cacheAvail(in_msg.addr) == false) {
                        Addr victim := LLC.cacheProbe(in_msg.addr);
                        LLC_Entry victim_entry := getLLCEntry(victim);
                        if (victim_entry.Dirty) {
                            Addr missing_parent := getFirstMissingParent(victim);
                            if (missing_parent != intToAddress(0)) {
                                DPRINTF(Tectree, "[Eviction Sospesa] La vittima 0x%x (Dato o Counter) ha il genitore 0x%x mancante! Sospendo lo sfratto per recuperarlo.\n", victim, missing_parent);
                                trigger(Event:LLC_Repl_Dirty_Auth_Miss, victim, victim_entry, TBEs[victim]);
                            } else {
                                DPRINTF(Tectree, "[Eviction Diretta] La vittima 0x%x ha l'intero ramo in LLC. Sfratto diretto consentito!\n", victim);
                                trigger(Event:LLC_Repl_Dirty, victim, victim_entry, TBEs[victim]);
                            }
                        } else {
                            trigger(Event:LLC_Repl_Clean, victim, victim_entry, TBEs[victim]);
                        }
                    } else {
						if (AuthTBEs.isPresent(in_msg.addr)) {
							trigger(Event:Counter_Data, in_msg.addr, getLLCEntry(in_msg.addr), TBEs[in_msg.addr]);
						} else {
				        	trigger(Event:Memory_Data, in_msg.addr, cache_entry, tbe);			//Trigger a Memory_Data (datablock arrived to TM)
						}
                    }
                } else if (in_msg.Type == MemoryRequestType:MEMORY_WB) {//If the request is MEMORY WB
                    trigger(Event:Memory_Ack, in_msg.addr, cache_entry, tbe);			//Trigger a Memory_Ack (Write of data to Memory finished)
                } else {
                    error("Invalid message");
                }
            }
        }
    }

	//Input port to get the follows responses FLUSH_REP and WB_REP from Caches
    in_port(response_in, ResponseMsg, responseFromCache) {
        if (response_in.isReady(clockEdge())) {
            peek(response_in, ResponseMsg) {
				assert(machineIDToMachineType(in_msg.Sender) == MachineType:L1Cache);
				Entry dir_entry := getDirectoryEntry(in_msg.addr);
				DPRINTF(RubySlicc, "Received in response_in %s with address 0x%x from cache %s and state %s\n", in_msg.Type, in_msg.addr, in_msg.Sender, dir_entry.DirState);
				TBE tbe := TBEs[in_msg.addr];
				LLC_Entry cache_entry := getLLCEntry(in_msg.addr);

				mts := max(mts, in_msg.rts);
                if (dir_entry.DirState != State:E_Evict_Flush && is_invalid(cache_entry) && LLC.cacheAvail(in_msg.addr) == false) {
                    Addr victim := LLC.cacheProbe(in_msg.addr);
                    LLC_Entry victim_entry := getLLCEntry(victim);
                    if (victim_entry.Dirty) {
                        Addr missing_parent := getFirstMissingParent(victim);
                        if (missing_parent != intToAddress(0)) {
                            DPRINTF(Tectree, "[Eviction Sospesa] (Response) La vittima 0x%x ha il genitore 0x%x mancante! Sospendo lo sfratto.\n", victim, missing_parent);
                            trigger(Event:LLC_Repl_Dirty_Auth_Miss, victim, victim_entry, TBEs[victim]);
                        } else {
                            DPRINTF(Tectree, "[Eviction Diretta] (Response) La vittima 0x%x ha l'intero ramo in LLC. Sfratto diretto!\n", victim);
                            trigger(Event:LLC_Repl_Dirty, victim, victim_entry, TBEs[victim]);
                        }
                    } else {
                        trigger(Event:LLC_Repl_Clean, victim, victim_entry, TBEs[victim]);
                    }
                } else {
				    if (in_msg.Type == CoherenceResponseType:FLUSH_REP || in_msg.Type == CoherenceResponseType:WB_REP || in_msg.Type == CoherenceResponseType:PUT_REP) {
                        if (dir_entry.DirState == State:E_Evict_Flush) {
                            Addr counter_addr := getParentAddrDynamic(in_msg.addr, tectree_arity);
                            if (LLC.isTagPresent(counter_addr)) {
                                trigger(Event:LLC_Repl_Dirty_Auth_Hit_From_Flush, in_msg.addr, cache_entry, tbe);
                            } else {
                                trigger(Event:LLC_Repl_Dirty_Auth_Miss_From_Flush, in_msg.addr, cache_entry, tbe);
                            }
                        } else {
                            trigger(Event:FlushRep, in_msg.addr, cache_entry, tbe);
                        }
				    } else {
                        error("Unexpected message type.");
                    }
                }
            }
        }
    }

	//Input port to get the follows requests SH_REQ, EX_REQ
    in_port(request_in, RequestMsg, requestFromCache) {
        if (request_in.isReady(clockEdge())) {
            peek(request_in, RequestMsg) {
				Entry dir_entry := getDirectoryEntry(in_msg.addr);
				TBE tbe := TBEs[in_msg.addr];
				LLC_Entry cache_entry := getLLCEntry(in_msg.addr);
                DPRINTF(RubySlicc, "Received in request_in %s with address 0x%x (%s) from cache %s. %d. Owner: %s. Requestor==Owner %d \n",
						in_msg.Type, in_msg.addr, dir_entry.DirState, in_msg.Requestor, mts, dir_entry.Owner, dir_entry.Owner.isElement(in_msg.Requestor));
				
				if (in_msg.Type == CoherenceRequestType:SH_REQ) {
					dir_entry.rts := max(dir_entry.rts, dir_entry.wts + lease, in_msg.lts + lease);
					if (is_valid(cache_entry)) {
						trigger(Event:ShReq_Hit, in_msg.addr, cache_entry, tbe);
					} else {
						//Intercettazione Miss: e verifica del counter
						Addr parent_L1 := getParentAddrDynamic(in_msg.addr, tectree_arity);
						bool counter_missing := (parent_L1 != intToAddress(0)) && (LLC.isTagPresent(parent_L1) == false);
						if (counter_missing) {
							DPRINTF(Tectree, "[Auth Miss] Dato 0x%x in stallo. Manca il Counter L1 0x%x in LLC.\n", in_msg.addr, parent_L1);
							trigger(Event:Auth_Miss, in_msg.addr, cache_entry, tbe);
						} else {
							if (parent_L1 != intToAddress(0)) {
								DPRINTF(Tectree, "[Auth Hit] Dato 0x%x procede (SH_REQ). Il Counter L1 0x%x e' in LLC.\n", in_msg.addr, parent_L1);
								if (mru_policy == 0) {
	LLC.setMRU(parent_L1);
	} else if (mru_policy == 2 && (rand() % 10 < 3)) { LLC.setMRU(parent_L1); }
								Addr parent_L2 := getParentAddrDynamic(parent_L1, tectree_arity);
								if (parent_L2 != intToAddress(0) && LLC.isTagPresent(parent_L2)) {
									if (mru_policy == 0) {
	LLC.setMRU(parent_L2);
									DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L2 0x%x\n", parent_L2);
	} else if (mru_policy == 2 && (rand() % 10 < 4)) { LLC.setMRU(parent_L2); }
									Addr parent_L3 := getParentAddrDynamic(parent_L2, tectree_arity);
									if (parent_L3 != intToAddress(0) && LLC.isTagPresent(parent_L3)) {
										if (mru_policy == 0) {
	LLC.setMRU(parent_L3);
										DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L3 0x%x\n", parent_L3);
	} else if (mru_policy == 2 && (rand() % 10 < 5)) { LLC.setMRU(parent_L3); }
										Addr parent_L4 := getParentAddrDynamic(parent_L3, tectree_arity);
										if (parent_L4 != intToAddress(0) && LLC.isTagPresent(parent_L4)) {
											if (mru_policy == 0) {
	LLC.setMRU(parent_L4);
											DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L4 0x%x\n", parent_L4);
	} else if (mru_policy == 2 && (rand() % 10 < 6)) { LLC.setMRU(parent_L4); }
											Addr parent_L5 := getParentAddrDynamic(parent_L4, tectree_arity);
											if (parent_L5 != intToAddress(0) && LLC.isTagPresent(parent_L5)) {
												if (mru_policy == 0) {
	LLC.setMRU(parent_L5);
												DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L5 0x%x\n", parent_L5);
	} else if (mru_policy == 2 && (rand() % 10 < 8)) { LLC.setMRU(parent_L5); }
												Addr parent_L6 := getParentAddrDynamic(parent_L5, tectree_arity);
												if (parent_L6 != intToAddress(0) && LLC.isTagPresent(parent_L6)) {
													if (mru_policy == 0) {
	LLC.setMRU(parent_L6);
													DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L6  0x%x\n", parent_L6);
	} else if (mru_policy == 2) { LLC.setMRU(parent_L6); }
												}
											}
										}
									}
								}
							}
							trigger(Event:ShReq, in_msg.addr, cache_entry, tbe);
						}
					}
				} else if(in_msg.Type == CoherenceRequestType:EX_REQ) {
					if(in_msg.wts == dir_entry.wts && in_msg.wts > 0){ 
						trigger(Event:UpgReq, in_msg.addr, cache_entry, tbe);
					}else{
						if (is_valid(cache_entry)) {
							trigger(Event:ExReq_Hit, in_msg.addr, cache_entry, tbe);
						} else {
							// Intercettazione Miss: il Counter c'è?
							Addr parent_L1 := getParentAddrDynamic(in_msg.addr, tectree_arity);
							bool counter_missing := (parent_L1 != intToAddress(0)) && (LLC.isTagPresent(parent_L1) == false);
							if (counter_missing) {
								DPRINTF(Tectree, "[Auth Miss] Dato 0x%x in stallo. Manca il Counter L1 0x%x in LLC.\n", in_msg.addr, parent_L1);
								trigger(Event:Auth_Miss, in_msg.addr, cache_entry, tbe);
							} else {
								if (parent_L1 != intToAddress(0)) {
									DPRINTF(Tectree, "[Auth Hit] Dato 0x%x procede (EX_REQ). Il Counter L1 0x%x e' in LLC.\n", in_msg.addr, parent_L1);
									if (mru_policy == 0) {
	LLC.setMRU(parent_L1);
	} else if (mru_policy == 2 && (rand() % 10 < 3)) { LLC.setMRU(parent_L1); }
									Addr parent_L2 := getParentAddrDynamic(parent_L1, tectree_arity);
									if (parent_L2 != intToAddress(0) && LLC.isTagPresent(parent_L2)) {
										if (mru_policy == 0) {
	LLC.setMRU(parent_L2);
										DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L2 0x%x\n", parent_L2);
	} else if (mru_policy == 2 && (rand() % 10 < 4)) { LLC.setMRU(parent_L2); }
										Addr parent_L3 := getParentAddrDynamic(parent_L2, tectree_arity);
										if (parent_L3 != intToAddress(0) && LLC.isTagPresent(parent_L3)) {
											if (mru_policy == 0) {
	LLC.setMRU(parent_L3);
										DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L3 0x%x\n", parent_L3);
	} else if (mru_policy == 2 && (rand() % 10 < 5)) { LLC.setMRU(parent_L3); }
											Addr parent_L4 := getParentAddrDynamic(parent_L3, tectree_arity);
											if (parent_L4 != intToAddress(0) && LLC.isTagPresent(parent_L4)) {
												if (mru_policy == 0) {
	LLC.setMRU(parent_L4);
												
												DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L4 0x%x\n", parent_L4);
	} else if (mru_policy == 2 && (rand() % 10 < 6)) { LLC.setMRU(parent_L4); }
												Addr parent_L5 := getParentAddrDynamic(parent_L4, tectree_arity);
												if (parent_L5 != intToAddress(0) && LLC.isTagPresent(parent_L5)) {
													if (mru_policy == 0) {
	LLC.setMRU(parent_L5);
													
													DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L5 0x%x\n", parent_L5);
	} else if (mru_policy == 2 && (rand() % 10 < 8)) { LLC.setMRU(parent_L5); }
													Addr parent_L6 := getParentAddrDynamic(parent_L5, tectree_arity);
													if (parent_L6 != intToAddress(0) && LLC.isTagPresent(parent_L6)) {
														if (mru_policy == 0) {
	LLC.setMRU(parent_L6);
														DPRINTF(Tectree, "[MRU Update] Auth Hit: Aggiornato MRU del Counter L6  0x%x\n", parent_L6);
	} else if (mru_policy == 2) { LLC.setMRU(parent_L6); }
													}
												}
											}
										}
									}
								}
								trigger(Event:ExReq, in_msg.addr, cache_entry, tbe);	//Send a memory request
							}
						}
					}
				} else {
                    error("Unexpected message type.");
                }
            }
        }
    }



    /*************************************************************************/
	/**Tardis TSO actions*/
	// Below are all of the actions that might be taken on a transition.
	
	action(sendMemoryRequest, "sMR", desc="Send a memory request to DRAM to get a block"){
        peek(request_in, RequestMsg) {
            if (is_ctr_mode == false) {
			    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
				    out_msg.addr := address;
				    out_msg.Type := MemoryRequestType:MEMORY_READ;
				    out_msg.Sender := machineID;
				    out_msg.OriginalRequestorMachId := in_msg.Requestor;
				    out_msg.OriginalRequestorAddr := intToAddress(0);
				    out_msg.MessageSize := MessageSizeType:Request_Control;
				    out_msg.Len := 0;
			    }
            } else {
			    enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency) {
				    out_msg.addr := address;
				    out_msg.Type := MemoryRequestType:MEMORY_READ;
				    out_msg.Sender := machineID;
				    out_msg.OriginalRequestorMachId := in_msg.Requestor;
				    out_msg.OriginalRequestorAddr := intToAddress(0);
				    out_msg.MessageSize := MessageSizeType:Request_Control;
				    out_msg.Len := 0;
			    }
            }
		}
	}
	
	action(sendShDataToReq, "sSDTR", desc="Send the block in read permission to the Cache Requestor (with a lease)"){
		peek(memQueue_in, MemoryMsg) {
			Entry dir_entry := getDirectoryEntry(address);
			DPRINTF(RubySlicc, "Send to %s block 0x%x [%s]\n", tbe.Requestor, address, in_msg.DataBlk);
			dir_entry.rts := max(dir_entry.rts, dir_entry.wts + lease, tbe.lts + lease);
            enqueue(response_out, ResponseMsg, 1 + crypto_latency) {
                out_msg.addr := address;
                out_msg.Sender := machineID;
                out_msg.Destination.clear();
				out_msg.Destination.add(tbe.Requestor);
				out_msg.rts := dir_entry.rts;
				if(tbe.wts == dir_entry.wts && dir_entry.wts > 0){
					out_msg.Type := CoherenceResponseType:RENEW_REP;
                	out_msg.MessageSize := MessageSizeType:Control;
				}else{
					out_msg.Type := CoherenceResponseType:SH_REP;
					out_msg.MessageSize := MessageSizeType:Data;
					out_msg.DataBlk := in_msg.DataBlk;       
					out_msg.wts := dir_entry.wts;        	
				}				
            }
        }
	}
	
	action(sendShTBEDataToReq, "sSDTRRR", desc=""){
		Entry dir_entry := getDirectoryEntry(address);
		DPRINTF(RubySlicc, "Send (WB) to %s block 0x%x [%s]\n", tbe.Requestor, address, tbe.DataBlk);
		enqueue(response_out, ResponseMsg, 1){
			out_msg.addr := tbe.PhysicalAddress;
            out_msg.Type := CoherenceResponseType:SH_REP;
            out_msg.Sender := machineID;
			out_msg.Destination.clear();
			out_msg.Destination.add(tbe.Requestor);
            out_msg.DataBlk := tbe.DataBlk;
            out_msg.MessageSize := MessageSizeType:Data;
			dir_entry.rts := max(dir_entry.rts, dir_entry.wts + lease, tbe.lts + lease);
			out_msg.wts := dir_entry.wts;
			out_msg.rts := dir_entry.rts;
		}
	}

	action(sendExDataToReq, "sEDTR", desc="Send the block in read-write permission to the Cache Requestor"){
		peek(memQueue_in, MemoryMsg) {
			Entry dir_entry := getDirectoryEntry(address);
			DPRINTF(RubySlicc, "Send to %s block 0x%x [%s]\n", tbe.Requestor, address, in_msg.DataBlk);
            enqueue(response_out, ResponseMsg, 1 + crypto_latency) {
                out_msg.addr := address;
                out_msg.Type := CoherenceResponseType:EX_REP;
                out_msg.Sender := machineID;
				out_msg.Destination.clear();
				out_msg.Destination.add(tbe.Requestor);
				out_msg.DataBlk := in_msg.DataBlk;
                out_msg.MessageSize := MessageSizeType:Data;
				out_msg.rts := dir_entry.rts;
				out_msg.wts := dir_entry.wts;
            }
        }
	}

	action(sendShDataFromLLC, "sSDFL", desc="Send the block in read permission to the Cache Requestor from LLC"){
		peek(request_in, RequestMsg) {
			Entry dir_entry := getDirectoryEntry(address);
			DPRINTF(RubySlicc, "Send to %s block 0x%x from LLC [%s]\n", in_msg.Requestor, address, cache_entry.DataBlk);
			DPRINTF(TectreeLLC, "LLC HIT (GetS)! Servendo il blocco 0x%x alla cache %s direttamente dalla LLC.\n", address, in_msg.Requestor);
            enqueue(response_out, ResponseMsg, 1) {
                out_msg.addr := address;
                out_msg.Sender := machineID;
                out_msg.Destination.clear();
				out_msg.Destination.add(in_msg.Requestor);
				out_msg.rts := dir_entry.rts;
				if(in_msg.wts == dir_entry.wts && dir_entry.wts > 0){
					out_msg.Type := CoherenceResponseType:RENEW_REP;
                	out_msg.MessageSize := MessageSizeType:Control;
				}else{
					out_msg.Type := CoherenceResponseType:SH_REP;
					out_msg.MessageSize := MessageSizeType:Data;
					out_msg.DataBlk := cache_entry.DataBlk;       
					out_msg.wts := dir_entry.wts;        	
				}				
            }
        }
	}

	action(sendExDataFromLLC, "sEDFL", desc="Send the block in read-write permission to the Cache Requestor from LLC"){
		peek(request_in, RequestMsg) {
			Entry dir_entry := getDirectoryEntry(address);
			DPRINTF(RubySlicc, "Send to %s block 0x%x from LLC [%s]\n", in_msg.Requestor, address, cache_entry.DataBlk);
			DPRINTF(TectreeLLC, "LLC HIT (GetM)! Servendo il blocco 0x%x alla cache %s direttamente dalla LLC.\n", address, in_msg.Requestor);
            enqueue(response_out, ResponseMsg, 1) {
                out_msg.addr := address;
                out_msg.Type := CoherenceResponseType:EX_REP;
                out_msg.Sender := machineID;
				out_msg.Destination.clear();
				out_msg.Destination.add(in_msg.Requestor);
				out_msg.DataBlk := cache_entry.DataBlk;
                out_msg.MessageSize := MessageSizeType:Data;
				out_msg.rts := dir_entry.rts;
				out_msg.wts := dir_entry.wts;
            }
        }
	}


	action(sendExTBEDataToReq, "sETBEDTR", desc=""){
		assert(is_valid(tbe));
		Entry dir_entry := getDirectoryEntry(address);
		enqueue(response_out, ResponseMsg, 1){
			out_msg.addr := address;
			out_msg.Type := CoherenceResponseType:EX_REP;
			out_msg.Sender := machineID;
			out_msg.Destination.clear();
			out_msg.Destination.add(tbe.Requestor);
			out_msg.DataBlk := tbe.DataBlk;
			out_msg.MessageSize := MessageSizeType:Data;
			out_msg.wts := dir_entry.wts;
			out_msg.rts := dir_entry.rts;
		}
	}

	action(sendWritebackRequest, "sWR", desc="Send a WB_REQ to the Owner due to a Shared request of another Cache"){
		peek(request_in, RequestMsg){
			Entry dir_entry := getDirectoryEntry(address);
			DPRINTF(RubySlicc, "Send to %s block 0x%x [wb req]\n", dir_entry.Owner, address);
			enqueue(forward_out, RequestMsg, directory_latency){
				out_msg.addr := address;
				out_msg.Type := CoherenceRequestType:WB_REQ;
				out_msg.Requestor := machineID;
				out_msg.Destination.clear();
				out_msg.Destination := dir_entry.Owner;
				out_msg.MessageSize := MessageSizeType:Control;
				out_msg.rts := in_msg.lts + lease;
			}
		}
	}
	
	action(sendFlushReq, "sFR", desc="Send a FLUSH_REQ to the owner due to an Exclusive request of another Cache"){
		Entry dir_entry := getDirectoryEntry(address);
		DPRINTF(RubySlicc, "Send flush request to %s with address 0x%x [%s]\n", dir_entry.Owner, address);
		enqueue(forward_out, RequestMsg, directory_latency){
			out_msg.addr := address;
			out_msg.Type := CoherenceRequestType:FLUSH_REQ;
			out_msg.Requestor := machineID;
			out_msg.Destination.clear();
			out_msg.Destination := dir_entry.Owner;
			out_msg.MessageSize := MessageSizeType:Control;
		}
	}

	action(sendBlockToMem, "sBTM", desc="When the TM get the block, send it to Memory and wait for the Ack"){
		DPRINTF(RubySlicc, "Send WB to memory address 0x%x\n", address);
		peek(response_in, ResponseMsg){
			enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
				out_msg.addr := address;
				out_msg.Type := MemoryRequestType:MEMORY_WB;
				out_msg.Sender := machineID;
				out_msg.MessageSize := MessageSizeType:Writeback_Data;
				out_msg.DataBlk := in_msg.DataBlk;
			}
		}
    }

    action(sendBlockToMem_Eviction, "sBTME", desc="Send victim block to Memory for LLC eviction"){
        DPRINTF(TectreeLLC, "LLC WRITEBACK: Invio del blocco 0x%x alla memoria per eviction.\n", address);
        enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
            out_msg.addr := address;
            out_msg.Type := MemoryRequestType:MEMORY_WB;
            out_msg.Sender := machineID;
            out_msg.MessageSize := MessageSizeType:Writeback_Data;
            out_msg.DataBlk := tbe.DataBlk;
        }
    }

	action(sendUpgradeRep, "sURes", desc=""){
		Entry dir_entry := getDirectoryEntry(address);
		DPRINTF(RubySlicc, "Send to cache an Upgrade response address 0x%x\n", address);
		peek(request_in, RequestMsg){
			enqueue(response_out, ResponseMsg, directory_latency) {
				out_msg.addr := address;
            	out_msg.Type := CoherenceResponseType:UPGR_REP;
           		out_msg.Sender := machineID;
				out_msg.Destination.clear();
				out_msg.Destination.add(in_msg.Requestor);
            	out_msg.MessageSize := MessageSizeType:Control;
				out_msg.rts := dir_entry.rts;
			}
		}
	}

	action(setMemoryTimestamps, "sMTs", desc=""){
		peek(memQueue_in, MemoryMsg){
			Entry dir_entry := getDirectoryEntry(address);
			dir_entry.wts := mts;
			dir_entry.rts := mts;
		}
	}

	action(setLLCTimestamps, "sLLCTs", desc="Set timestamps when serving from LLC"){
		peek(request_in, RequestMsg){
			Entry dir_entry := getDirectoryEntry(address);
			dir_entry.wts := mts;
			dir_entry.rts := mts;
		}
	}



	action(setOwner_ReqIn, "sOR", desc="Set the owner") {
		peek(request_in, RequestMsg){
			assert(machineIDToMachineType(in_msg.Requestor) == MachineType:L1Cache);
			assert(getDirectoryEntry(address).Owner.count() == 0);
			getDirectoryEntry(address).Owner.add(in_msg.Requestor);
			DPRINTF(RubySlicc, "New owner (req in): %s\n", in_msg.Requestor);
		}
    }

	action(setOwner, "sO", desc="Set the owner") {
		assert(is_valid(tbe));
		assert(machineIDToMachineType(tbe.Requestor) == MachineType:L1Cache);
		getDirectoryEntry(address).Owner.clear();
    	getDirectoryEntry(address).Owner.add(tbe.Requestor);
		DPRINTF(RubySlicc, "New owner: %s\n", tbe.Requestor);
    }
	
	action(clearOwner, "cO", desc="Clear the owner") {
		getDirectoryEntry(address).Owner.clear();
    }
	
	action(storeDataBlockTBE, "sDBTBE", desc="Store in TBE entry the datablock from response queue."){
		peek(response_in, ResponseMsg) {
			assert(is_valid(tbe));
			tbe.DataBlk := in_msg.DataBlk;
		}
	}

	action(storeLtsTBE_ReqIn, "sLTBEREQ", desc="Store in TBE entry the lts from request queue."){
		peek(request_in, RequestMsg){
			assert(is_valid(tbe));
			tbe.lts := in_msg.lts;
		}
	}

	action(storeLtsTBE_RepIn, "sLTBEREP", desc="Store in TBE entry the lts from response queue."){
		peek(response_in, ResponseMsg){
			assert(is_valid(tbe));
			tbe.lts := in_msg.lts;
		}
	}

    action(storeTimestampsTBE_ReqIn, "sTTBEREQ", desc="Store in TBE entry the wts and rts from request queue."){
		peek(request_in, RequestMsg){
			assert(is_valid(tbe));
			tbe.wts := in_msg.wts;
			tbe.rts := in_msg.rts;
		}
	}

	action(storeTimestampsTBE_RepIn, "sTTBEREP", desc="Store in TBE entry the wts and rts from response queue."){
		peek(response_in, ResponseMsg){
			assert(is_valid(tbe));
			tbe.wts := in_msg.wts;
			tbe.rts := in_msg.rts;
		}
	}

	action(storeTimestamps_RepIn, "sTs", desc="Store in Directory entry the wts and rts from response queue."){
		Entry dir_entry := getDirectoryEntry(address);
		peek(response_in, ResponseMsg){
			dir_entry.wts := in_msg.wts;
			dir_entry.rts := in_msg.rts;
		}
	}

	action(allocateTBE_ReqIn, "aTBE", desc="Allocate TBE with Request message info.") {
		peek(request_in, RequestMsg) {
			TBEs.allocate(address);
			set_tbe(TBEs[address]);
			tbe.PhysicalAddress := in_msg.addr;
			tbe.Requestor := in_msg.Requestor;
			DPRINTF(RubySlicc, "Allocated TBE [Requestor: %s, Address: 0x%x]\n", tbe.Requestor, tbe.PhysicalAddress);
		}
	}
	
	action(allocateTBE_RepIn, "aTBER", desc="Allocate TBE with Response message info.") {
		peek(response_in, ResponseMsg) {
			TBEs.allocate(address);
			set_tbe(TBEs[address]);
			tbe.PhysicalAddress := in_msg.addr;
			tbe.Requestor := in_msg.Sender;
			DPRINTF(RubySlicc, "Allocated TBE Response [Requestor: %s, Address: 0x%x]\n", tbe.Requestor, tbe.PhysicalAddress);
		}
	}

    action(allocateTBE_Eviction, "aTBEE", desc="Allocate TBE for eviction") {
        TBEs.allocate(address);
        set_tbe(TBEs[address]);
        tbe.PhysicalAddress := address;
        if (is_valid(cache_entry)) {
            tbe.DataBlk := cache_entry.DataBlk;
        }
        Entry dir_entry := getDirectoryEntry(address);
        tbe.wts := dir_entry.wts;
        tbe.rts := dir_entry.rts;
        DPRINTF(RubySlicc, "Allocated TBE for Eviction [Address: 0x%x]\n", tbe.PhysicalAddress);
    }

	action(deallocateTBE, "w", desc="Deallocate TBE") {
		assert(is_valid(tbe));
		TBEs.deallocate(address);
		unset_tbe();
	}

	action(sendAckRepTBE, "sART", desc="Send to requestor in TBE the acknoledgement response."){
		assert(is_valid(tbe));
		enqueue(response_out, ResponseMsg, 1){
			out_msg.addr := tbe.PhysicalAddress;
			out_msg.Type := CoherenceResponseType:ACK_REP;
			out_msg.Destination.clear();
			out_msg.Destination.add(tbe.Requestor);
			out_msg.Sender := machineID;
			out_msg.MessageSize := MessageSizeType:Control;
		}
	}

    // LLC Actions
    action(allocateLLC, "all", desc="Allocate LLC block") {
        if (is_invalid(cache_entry)) {
            set_cache_entry(LLC.allocate(address, new LLC_Entry));
        }
    }

    action(allocateOrUpdateLLC, "aLLC", desc="Allocate or update LLC block on Put") {
        peek(response_in, ResponseMsg) {
            if (is_valid(cache_entry)) {
				DPRINTF(TectreeLLC, "LLC UPDATE: Aggiornamento dei dati per il blocco 0x%x in LLC a seguito di un eviction.\n", address);
                cache_entry.DataBlk := in_msg.DataBlk;
                cache_entry.Dirty := true;
                LLC.setMRU(address);
            } else {
				DPRINTF(TectreeLLC, "LLC ALLOCATE: Allocazione di un nuovo blocco 0x%x in LLC a seguito di un eviction.\n", address);
                set_cache_entry(LLC.allocate(address, new LLC_Entry));
                cache_entry.DataBlk := in_msg.DataBlk;
                cache_entry.Dirty := true;
            }

        }
    }

	action(allocateOrUpdateLLCFromMem, "aLLCM", desc="Allocate or update a block in LLC from Memory") {
		peek(memQueue_in, MemoryMsg) {
			if (is_valid(cache_entry)) {
				DPRINTF(TectreeLLC, "LLC UPDATE: Aggiornamento dei dati per il blocco 0x%x in LLC a seguito di una Memory_Data.\n", address);
				cache_entry.DataBlk := in_msg.DataBlk;
                cache_entry.Dirty := false;
				LLC.setMRU(address);
			} else {
				DPRINTF(TectreeLLC, "LLC ALLOCATE: Allocazione di un nuovo blocco 0x%x in LLC a seguito di una Memory_Data.\n", address);
				set_cache_entry(LLC.allocate(address, new LLC_Entry));
				cache_entry.DataBlk := in_msg.DataBlk;
                cache_entry.Dirty := false;
			}

			
		}
	}

    action(allocateCounterLLC, "aCLLC", desc="Allocate Counter in LLC from MemMsg") {
        peek(memQueue_in, MemoryMsg) {
            if (LLC.isTagPresent(in_msg.addr) == false) {
				DPRINTF(TectreeLLC, "LLC ALLOCATE: Allocazione di un nuovo counter 0x%x in LLC.\n", in_msg.addr);
                LLC.allocate(in_msg.addr, new LLC_Entry);
            } else {
				DPRINTF(TectreeLLC, "LLC UPDATE: Aggiornamento del counter 0x%x in LLC.\n", in_msg.addr);
			}
            LLC_Entry counter_entry := getLLCEntry(in_msg.addr);
            counter_entry.DataBlk := in_msg.DataBlk;
            counter_entry.Dirty := false;
            getDirectoryEntry(in_msg.addr).DirState := State:C_V;
			LLC.setMRU(in_msg.addr);
        }
    }

    action(recordPrefetchMiss, "pm", desc="Record a dirty metadata eviction") {
        LLC.profilePrefetchMiss();
    }

    action(recordPrefetchHit, "ph", desc="Record a clean metadata eviction") {
        LLC.profilePrefetchHit();
    }

    action(incrementRootCounter, "iRC", desc="Incrementa il Root Counter su statistica nativa") {
        int idx := getL6Index(address);
        if (idx == 0) {
            root_cnt_0 := root_cnt_0 + 1;
            DPRINTF(Tectree, "[Root]: Incremento per Scrittura Ramo 0 (Valore: %d)\n", root_cnt_0);
        } else if (idx == 1) {
            root_cnt_1 := root_cnt_1 + 1;
            DPRINTF(Tectree, "[Root]: Incremento per Scrittura Ramo 1 (Valore: %d)\n", root_cnt_1);
        } else if (idx == 2) {
            root_cnt_2 := root_cnt_2 + 1;
            DPRINTF(Tectree, "[Root]: Incremento per Scrittura Ramo 2 (Valore: %d)\n", root_cnt_2);
        }
        LLC.profileDemandHit();
    }

    action(deallocateLLC, "dea", desc="Deallocate LLC block") {
        if (is_valid(cache_entry)) {
            LLC.deallocate(address);
            unset_cache_entry();
        }
    }



    action(setMRU, "mru", desc="Set MRU") {
        if (is_valid(cache_entry)) {
            LLC.setMRU(address);
            
            
            setMRUTree(address);
        }
    }
	//--Action per l AuthTBE---------------------------------------------------------
	action(fetchCounterIfNeeded, "fC", desc="Invia memory read per il counter solo se non in flight") {
		peek(request_in, RequestMsg) {
			Addr counter_addr := getParentAddrDynamic(address, tectree_arity);
			if (AuthTBEs.isPresent(counter_addr) == false) {
				AuthTBEs.allocate(counter_addr);
				enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
					out_msg.addr := counter_addr;
					out_msg.Type := MemoryRequestType:MEMORY_READ;
					out_msg.Sender := machineID;
					out_msg.OriginalRequestorAddr := counter_addr;
					out_msg.MessageSize := MessageSizeType:Request_Control;
					out_msg.Len := 0;
				}
				DPRINTF(Tectree, "[Fetch Counter] Avvio fetch per il counter 0x%x\n", counter_addr);
			} else {
				DPRINTF(Tectree, "[Fetch Counter] Il counter 0x%x e' gia' in fase di fetch. Stallo e mi accodo.\n", counter_addr);
			}
		}
	}

	action(fetchCounterForEviction, "fCE", desc="Fetch counter during eviction") {
		Addr counter_addr := getFirstMissingParent(address);
		if (AuthTBEs.isPresent(counter_addr) == false) {
			AuthTBEs.allocate(counter_addr);
			enqueue(memQueue_out, MemoryMsg, to_memory_controller_latency + crypto_latency) {
				out_msg.addr := counter_addr;
				out_msg.Type := MemoryRequestType:MEMORY_READ;
				out_msg.Sender := machineID;
				out_msg.MessageSize := MessageSizeType:Request_Control;
				out_msg.Len := 0;
			}
			DPRINTF(Tectree, "[4.4 Write-Allocate] Sfratto in sospeso. Fetch per il Counter 0x%x\\n", counter_addr);
		}
		
		// Inseriamo l'indirizzo del Dato (address) nel primo slot libero del Counter
		if (AuthTBEs.lookup_ref(counter_addr).Waiter0 == intToAddress(0)) { AuthTBEs.lookup_ref(counter_addr).Waiter0 := address; }
